# Required
OPENAI_API_KEY=sk-your-api-key-here

# Optional (with defaults)
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_RETRIES=2
DIGEST_OUTPUT_FILE=news.md
DIGEST_STATUS_FILE=digest-run-status.json
# Optional for CI-style issue preflight/publish. Local runs use authenticated `gh`.
# DIGEST_GITHUB_TOKEN=github_pat_your_token_here
# Optional for Actions-dispatch publishing.
# DIGEST_PUBLISH_WORKFLOW=publish-digest.yml
# DIGEST_ACTIONS_REF=main
PAPER_LIMIT=7
MAX_ITEMS_PER_SOURCE=6
RSS_TIMEOUT=10
RSS_RETRIES=2
RSS_MAX_WORKERS=8
RSS_MAX_FEED_BYTES=5000000
LOG_LEVEL=INFO

# Fork defaults: Chinese technology / AI Top 5, Beijing publication date
DIGEST_FORMAT=top5-zh
DIGEST_TIMEZONE=Asia/Shanghai
DIGEST_ISSUE_REPO=xudaniel/ai-news-agent
DIGEST_ISSUE_TITLE_PREFIX=科技与AI Top 5
# GitHub Actions schedule is opt-in: repository variable ENABLE_GITHUB_DIGEST=true.
# This repository publishes Issues; direct Gmail delivery uses the separate scheduled task.
